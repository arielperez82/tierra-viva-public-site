# Astro build: site URL and base path (used for sitemap, canonical, and asset URLs).
# Omit or leave unset to use defaults below.
#
# GitHub Pages (project site):
#   ASTRO_SITE=https://tierraviva.github.io
#   ASTRO_BASE=/tierra-viva-public-site/
#
# Custom domain (e.g. later):
#   ASTRO_SITE=https://www.tierravivainvest.com
#   ASTRO_BASE=/
#
# Defaults (used when not set): ASTRO_SITE=https://tierraviva.github.io, ASTRO_BASE=/tierra-viva-public-site/
# ASTRO_SITE=
# ASTRO_BASE=

# HubSpot lead form. Copy to .env.local for local testing.
# The form, its links and the privacy-policy wording switch on only when
# the portal and form IDs are both present and well formed.
# In production these are GitHub environment variables (github-pages).
# They are public by design: they end up in the page that posts the form.

# Settings > Account Management > Account Defaults > Hub ID
PUBLIC_HUBSPOT_PORTAL_ID=
# The form's GUID, from its editor URL or embed code
PUBLIC_HUBSPOT_FORM_ID=
# na1 (US, app.hubspot.com) or eu1 (EU, app-eu1.hubspot.com); defaults to na1
PUBLIC_HUBSPOT_REGION=na1
# Optional: subscription type ID for the "send me updates" checkbox
PUBLIC_HUBSPOT_SUBSCRIPTION_TYPE_ID=
