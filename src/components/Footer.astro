---
import Link from "./Link.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-tierra-forest-dark px-4 py-12 text-white sm:px-6 sm:py-16"
  role="contentinfo"
>
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-wider text-white/80"
        >
          Company
        </h3>
        <ul class="mt-4 space-y-3" role="list">
          <li>
            <Link
              href="/approach"
              class="text-sm text-white/60 transition hover:text-tierra-lime focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2 focus:ring-offset-tierra-forest-dark"
            >
              Our Approach
            </Link>
          </li>
          <li>
            <Link
              href="/education-impact"
              class="text-sm text-white/60 transition hover:text-tierra-lime focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2 focus:ring-offset-tierra-forest-dark"
            >
              Education &amp; Impact
            </Link>
          </li>
          <li>
            <Link
              href="/team"
              class="text-sm text-white/60 transition hover:text-tierra-lime focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2 focus:ring-offset-tierra-forest-dark"
            >
              Team
            </Link>
          </li>
        </ul>
      </div>

      <div>
        <h3
          class="text-sm font-semibold uppercase tracking-wider text-white/80"
        >
          Legal
        </h3>
        <ul class="mt-4 space-y-3" role="list">
          <li>
            <Link
              href="/privacy"
              class="text-sm text-white/60 transition hover:text-tierra-lime focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2 focus:ring-offset-tierra-forest-dark"
            >
              Privacy Policy
            </Link>
          </li>
          <li>
            <Link
              href="/jurisdiction"
              class="text-sm text-white/60 transition hover:text-tierra-lime focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2 focus:ring-offset-tierra-forest-dark"
            >
              Jurisdiction Notice
            </Link>
          </li>
          
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-8">
      <p class="text-center text-xs leading-relaxed text-white/40">
        This website provides general information about Tierra Viva Investments
        and its activities. It is not an offer to sell, or a solicitation of an
        offer to buy, any security or any interest in a fund or project, and it
        is not investment, legal or tax advice. Any offering would be made only
        to eligible investors through definitive offering documents and in
        accordance with applicable securities laws. Plans, concepts and
        renderings are preliminary and subject to change.
      </p>
      <p class="mt-4 text-center text-xs text-white/40">
        &copy; {currentYear} Tierra Viva Investments. All rights reserved.
      </p>
    </div>
  </div>
</footer>
