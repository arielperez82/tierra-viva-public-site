---
import { Image } from "astro:assets";
import { conversationHref } from "../../lib/lead-form-config";
import Link from "../Link.astro";
import schoolConcept from "../../assets/concepts/school-concept.jpg";
---

<section class="overflow-hidden bg-tierra-cream px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[50%_50%]">
    <div>
      <h1 class="text-4xl leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        Schools and communities, designed together.
      </h1>
      <p class="mt-6 text-lg leading-relaxed sm:text-xl">
        Tierra Viva is an investment and development platform bringing schools,
        homes and local enterprise together in Latin America and the Caribbean.
      </p>
      <p class="mt-4 text-base leading-relaxed text-tierra-graphite/80">
        We are beginning in Santiago, Dominican Republic, where our first
        community is in pre-development.
      </p>
      <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row">
        <Link
          href="/approach"
          class="inline-flex items-center justify-center rounded-lg bg-tierra-lime px-8 py-3.5 text-base font-semibold text-tierra-forest-dark shadow-sm transition hover:bg-tierra-lime/90 focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2"
        >
          Explore Our Approach
        </Link>
        <a
          href={conversationHref("other", "Starting a conversation with Tierra Viva")}
          class="inline-flex items-center justify-center rounded-lg border-2 border-tierra-stone px-8 py-3.5 text-base font-semibold text-tierra-ink transition hover:border-tierra-forest hover:text-tierra-forest focus:outline-none focus:ring-2 focus:ring-tierra-forest focus:ring-offset-2"
        >
          Start a Conversation
        </a>
      </div>
      <p class="mt-10 text-sm font-semibold uppercase tracking-wider text-tierra-forest">
        Living Capital for Living Places
      </p>
    </div>
    <figure>
      <Image
        src={schoolConcept}
        alt="Aerial concept rendering of a school campus with shaded walkways, gardens and playing fields set among trees and mountains."
        widths={[640, 960, 1536]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-xl object-cover shadow-md"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="mt-3 text-xs leading-relaxed text-tierra-graphite/70">
        Illustrative school concept. Design and program are subject to
        development and approvals.
      </figcaption>
    </figure>
  </div>
</section>
