---
import { CONTACT_EMAIL, contactHref } from "../../consts";

const PATHWAYS: readonly {
  readonly audience: string;
  readonly who: string;
  readonly invitation: string;
  readonly subject: string;
}[] = [
  {
    audience: "Capital partners",
    who: "Family offices, institutional investors and lenders",
    invitation:
      "Learn about the platform, our first community and how we work with capital partners.",
    subject: "Capital partnership",
  },
  {
    audience: "Development & operating partners",
    who: "Co-developers, builders and school operators",
    invitation: "Shape delivery, cost certainty and operating performance.",
    subject: "Development or operating partnership",
  },
  {
    audience: "Education & community partners",
    who: "Educators, employers, researchers and community organizations",
    invitation:
      "Help build education access, local enterprise and community learning.",
    subject: "Education or community partnership",
  },
];
---

<section
  id="connect"
  aria-labelledby="connect-heading"
  class="bg-tierra-cream px-4 py-16 sm:px-6 sm:py-24"
>
  <div class="mx-auto max-w-5xl">
    <h2
      id="connect-heading"
      class="text-center text-2xl tracking-tight sm:text-3xl"
    >
      Where could we work together?
    </h2>
    <p class="mt-6 text-center text-base leading-relaxed text-tierra-graphite/90 sm:text-lg">
      We welcome conversations with investors, development and operating
      partners, educators and organizations working to expand opportunity. Tell
      us about your work and what interests you about Tierra Viva.
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-3" role="list">
      {
        PATHWAYS.map((pathway) => (
          <li class="reveal flex flex-col rounded-xl border border-tierra-stone/40 bg-white p-8 shadow-sm">
            <h3 class="text-lg font-semibold text-tierra-forest">
              {pathway.audience}
            </h3>
            <p class="mt-2 text-sm font-medium text-tierra-ink">
              {pathway.who}
            </p>
            <p class="mt-3 grow text-sm leading-relaxed text-tierra-graphite/90">
              {pathway.invitation}
            </p>
            <a
              href={contactHref(pathway.subject)}
              class="mt-6 inline-flex items-center justify-center rounded-lg bg-tierra-lime px-6 py-3 text-sm font-semibold text-tierra-forest-dark shadow-sm transition hover:bg-tierra-lime/90 focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2"
            >
              Start a conversation
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-center text-sm text-tierra-graphite/80">
      Or write to us directly at{" "}
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="font-medium text-tierra-forest underline underline-offset-4"
      >
        {CONTACT_EMAIL}
      </a>
    </p>
  </div>
</section>
