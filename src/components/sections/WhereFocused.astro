---
import { Image } from "astro:assets";
import Link from "../Link.astro";
import residentialConcept from "../../assets/concepts/residential-street-concept.jpg";

const PROGRESS: readonly { readonly when: string; readonly what: string }[] = [
  {
    when: "2024–2025",
    what: "Market research and candidate-site screening.",
  },
  {
    when: "2025–2026",
    what: "Core team and specialist relationships assembled.",
  },
  {
    when: "July 2026",
    what: "Santiago visit, local stakeholder meetings and an initial phased development plan.",
  },
  {
    when: "October 2026",
    what: "Land agreement, school concept and operating-partner discussions under way.",
  },
];
---

<section
  id="santiago"
  aria-labelledby="santiago-heading"
  class="bg-tierra-sand px-4 py-16 sm:px-6 sm:py-24"
>
  <div class="mx-auto grid max-w-6xl items-start gap-12 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-tierra-forest">
        Our first community
      </p>
      <h2
        id="santiago-heading"
        class="mt-2 text-2xl tracking-tight sm:text-3xl"
      >
        Beginning in Santiago
      </h2>
      <p class="mt-6 text-base leading-relaxed text-tierra-graphite/90 sm:text-lg">
        Santiago de los Caballeros is the starting point for Tierra Viva. Its
        business community, universities and strong diaspora connections make
        it a compelling place to prove this model.
      </p>
      <p class="mt-4 text-base leading-relaxed text-tierra-graphite/90">
        The first community is in pre-development. Our current work focuses on
        securing the site, technical diligence and understanding household
        demand, alongside developing the school concept and prospective
        operating partnerships. Its design and delivery plan will be shaped by
        this work and by local stakeholders.
      </p>
      <h3 class="mt-10 text-lg font-semibold text-tierra-forest">
        Progress so far
      </h3>
      <ol class="mt-4 space-y-3 border-l-2 border-tierra-sage pl-6" role="list">
        {
          PROGRESS.map((step) => (
            <li>
              <span class="block text-sm font-semibold text-tierra-ink">
                {step.when}
              </span>
              <span class="text-sm leading-relaxed text-tierra-graphite/90">
                {step.what}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm leading-relaxed text-tierra-graphite/80">
        Still ahead: site control, demand validation, technical diligence and
        financing.
      </p>
      <p class="mt-8">
        <Link
          href="/approach"
          class="inline-flex items-center font-medium text-tierra-forest underline decoration-tierra-mid underline-offset-4 transition hover:decoration-tierra-forest focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2"
        >
          How we approach development
        </Link>
      </p>
    </div>
    <figure class="lg:mt-10">
      <Image
        src={residentialConcept}
        alt="Concept rendering of a tree-lined residential street with townhomes and families walking."
        widths={[640, 960, 1536]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full rounded-xl object-cover shadow-md"
      />
      <figcaption class="mt-3 text-xs leading-relaxed text-tierra-graphite/70">
        Illustrative residential concept. Design and program are subject to
        development and approvals.
      </figcaption>
    </figure>
  </div>
</section>
