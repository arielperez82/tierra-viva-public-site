---
import { PILLARS } from "../../data/pillars";
import PillarIcon from "../PillarIcon.astro";
---

<section
  id="why-model"
  aria-labelledby="why-model-heading"
  class="bg-tierra-cream px-4 py-16 sm:px-6 sm:py-24"
>
  <div class="mx-auto max-w-5xl">
    <h2
      id="why-model-heading"
      class="text-center text-2xl tracking-tight sm:text-3xl"
    >
      A place to build a future
    </h2>
    <p class="mt-6 text-center text-lg leading-relaxed">
      Choosing where to live involves more than finding a home. Families also
      weigh their children's education, everyday services and the community
      around them.
    </p>
    <p class="mt-4 text-center text-base leading-relaxed text-tierra-graphite/90">
      Tierra Viva plans these needs together. Our aim is to create places where
      families can put down roots and local businesses can grow, supported by
      investment that helps sustain the community.
    </p>
    <p class="mt-4 text-center text-base leading-relaxed text-tierra-graphite/90">
      We design for local professionals and business owners, returning
      diaspora families, and internationally connected people who want to
      build a life in the region.
    </p>
    <h3 class="mt-14 text-center text-xl tracking-tight text-tierra-forest">
      What we bring together
    </h3>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        PILLARS.map((pillar) => (
          <li>
            <article class="reveal flex h-full flex-col rounded-xl border border-tierra-stone/40 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <PillarIcon icon={pillar.icon} />
              <h4 class="mt-4 text-lg font-semibold text-tierra-forest">
                {pillar.title}
              </h4>
              <p class="mt-3 grow text-sm leading-relaxed text-tierra-graphite/90">
                {pillar.description}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
