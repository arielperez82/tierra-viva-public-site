---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Link from "../components/Link.astro";
import { SITE_TITLE } from "../consts";
import { NAA_DOWNLOADS, NAA_NEXT_STEPS } from "../data/naa";
import { withBase } from "../utils/with-base";
import {
  LEAD_FORM_ENABLED,
  conversationHref,
} from "../lib/lead-form-config";
import schoolConcept from "../assets/concepts/school-concept.jpg";

const RAMON_EMAIL = "ramon@tierravivainvest.com";

const THEMES: readonly { readonly title: string; readonly body: string }[] = [
  {
    title: "Underwriting discipline earns the second meeting.",
    body: "We would rather show you how we test our assumptions than only where they lead.",
  },
  {
    title: "Latin America's next wave is local.",
    body: "Our first community begins in Santiago, Dominican Republic, with local partners from the start.",
  },
  {
    title: "Alignment matters as much as access.",
    body: "We build with capital partners, operators and educators at the same table.",
  },
];

const NAA_TRACKING = {
  utm_source: "naa-2026",
  utm_medium: "web",
  utm_campaign: "naa-miami-2026",
  utm_content: "follow-up-page",
};

const ramonHref = (subject: string): string =>
  LEAD_FORM_ENABLED
    ? conversationHref("event", subject, NAA_TRACKING)
    : `mailto:${RAMON_EMAIL}?subject=${encodeURIComponent(subject)}`;

const sectionHeading = "text-2xl tracking-tight sm:text-3xl";
const bodyText = "text-base leading-relaxed text-tierra-graphite/90 sm:text-lg";
const primaryButton =
  "mt-6 inline-flex items-center justify-center whitespace-nowrap rounded-lg bg-tierra-lime px-6 py-3 text-sm font-semibold text-tierra-forest-dark shadow-sm transition hover:bg-tierra-lime/90 focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2";
---

<BaseLayout
  title={`Thank you from NAA Miami | ${SITE_TITLE}`}
  description="Thank you for meeting Tierra Viva at the NAA Global Capital Symposium in Miami Beach. Download our overview and presentation, and continue the conversation."
  noindex
>
  <article class="bg-tierra-cream px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-tierra-forest">
            NAA Global Capital Symposium · Fontainebleau Miami Beach · October
            13–15, 2026
          </p>
          <h1 class="mt-4 text-3xl tracking-tight sm:text-4xl lg:text-5xl">
            Thank you for the conversation in Miami.
          </h1>
          <p class="mt-6 text-lg leading-relaxed">
            This year's theme was widening the investment aperture. We heard it
            in sessions on how family offices are becoming institutional, where
            institutional capital is going across Latin America, and what it
            takes for a new manager to earn trust. We were glad to meet you
            there, and we would like to keep talking.
          </p>
        </div>
        <figure>
          <Image
            src={schoolConcept}
            alt="Aerial concept rendering of a school campus with shaded walkways, gardens and playing fields set among trees and mountains."
            widths={[640, 960, 1536]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full rounded-xl object-cover shadow-md"
            loading="eager"
          />
          <figcaption class="mt-3 text-xs leading-relaxed text-tierra-graphite/70">
            Illustrative school concept. Design and program are subject to
            development and approvals.
          </figcaption>
        </figure>
      </div>

      <section aria-labelledby="downloads-heading" class="mt-20">
        <h2 id="downloads-heading" class={sectionHeading}>
          Take Miami home with you
        </h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-2" role="list">
          {
            NAA_DOWNLOADS.map((download) => (
              <li class="flex flex-col rounded-xl border border-tierra-stone/40 bg-white p-8 shadow-sm">
                <h3 class="text-lg font-semibold text-tierra-forest">
                  {download.title}
                </h3>
                <p class="mt-3 grow text-sm leading-relaxed text-tierra-graphite/90">
                  {download.description}
                </p>
                <p class="mt-3 text-xs text-tierra-graphite/70">
                  {download.details}
                </p>
                <a href={withBase(download.href)} download class={primaryButton}>
                  {download.cta}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="themes-heading" class="mt-20">
        <h2 id="themes-heading" class={sectionHeading}>
          Three themes we kept hearing
        </h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-3" role="list">
          {
            THEMES.map((theme) => (
              <li class="rounded-xl border border-tierra-stone/40 bg-white p-6">
                <h3 class="font-semibold text-tierra-forest">{theme.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-tierra-graphite/90">
                  {theme.body}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="building-heading" class="mt-20">
        <h2 id="building-heading" class={sectionHeading}>
          Schools and communities, designed together.
        </h2>
        <p class={`mt-6 max-w-3xl ${bodyText}`}>
          Tierra Viva is a platform for Latin America and the Caribbean that
          plans a school and a complete neighborhood as one community. Our first
          community is in pre-development in Santiago, Dominican Republic.
        </p>
        <p class="mt-6">
          <Link
            href="/approach"
            class="font-medium text-tierra-forest underline decoration-tierra-stone underline-offset-4 hover:decoration-tierra-forest"
          >
            See our approach
          </Link>
        </p>
      </section>

      <section aria-labelledby="next-heading" class="mt-20">
        <h2 id="next-heading" class={sectionHeading}>
          Where the conversation goes next
        </h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-3" role="list">
          {
            NAA_NEXT_STEPS.map((step) => (
              <li class="flex flex-col rounded-xl border border-tierra-stone/40 bg-white p-6">
                <h3 class="font-semibold text-tierra-forest">{step.title}</h3>
                <p class="mt-2 grow text-sm text-tierra-graphite/90">
                  {step.when}
                </p>
                <a
                  href={ramonHref(step.subject)}
                  class="mt-4 text-sm font-medium text-tierra-forest underline decoration-tierra-stone underline-offset-4 hover:decoration-tierra-forest"
                >
                  Let us know you're interested
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-12 rounded-xl bg-white p-8 shadow-sm">
          <p class={bodyText}>
            Or simply reply to the conversation we started. Tell us your firm
            and what fits your mandate, and we will follow up personally.
          </p>
          <p class="mt-4 font-semibold text-tierra-forest-dark">
            Ramon Marmolejos
          </p>
          <p class="text-sm text-tierra-graphite/80">
            Founder &amp; Managing Partner ·{" "}
            <a
              href={ramonHref("Following up from NAA Miami")}
              class="font-medium text-tierra-forest underline underline-offset-4"
            >
              {RAMON_EMAIL}
            </a>
          </p>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
