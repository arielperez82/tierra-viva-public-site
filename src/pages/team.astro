---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import Link from "../components/Link.astro";
import ramonPhoto from "../assets/ramon-marmolejos.png";
import ranjanPhoto from "../assets/ranjan-khan-profile.jpg";
import josePhoto from "../assets/jose-l-zardoya-profile.jpg";
import henryPhoto from "../assets/henry-gonzalez-profile.png";
---

<BaseLayout
  title={`Team | ${SITE_TITLE}`}
  description="The Tierra Viva team: education, capital markets, operations and governance, and local market execution in the Dominican Republic."
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-2xl tracking-tight sm:text-3xl">
      Team
    </h1>
    <p class="mt-6 text-base leading-relaxed text-tierra-graphite/90">
      Our team combines education, capital markets, regulated-finance controls
      and local real estate execution in the Dominican Republic.
    </p>

    <h2 class="mt-10 text-xl font-semibold tracking-tight">
      Leadership
    </h2>
    <div class="mt-6 space-y-8">
      <section class="flex flex-col items-start gap-6 sm:flex-row">
        <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-full border-2 border-tierra-stone/40">
          <Image
            src={ramonPhoto}
            alt="Ramon Marmolejos"
            width={96}
            height={96}
            class="h-full w-full object-cover object-top"
          />
        </div>
        <div>
        <h3 class="font-semibold text-tierra-forest-dark">
          Ramon Marmolejos — Founder &amp; Managing Partner
        </h3>
        <p class="mt-2 text-base leading-relaxed text-tierra-graphite/90">
          Leads the platform and its education vision. Born in the Dominican
          Republic, Ramon brings more than 20 years in education, leadership
          development and impact, including co-founding Alkimia Learning.
          Wharton, IE Business School MBA and Harvard Ed.M.
        </p>
        </div>
      </section>

      <section class="flex flex-col items-start gap-6 sm:flex-row">
        <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-full border-2 border-tierra-stone/40">
          <Image
            src={ranjanPhoto}
            alt="Ranjan Khan"
            width={96}
            height={96}
            class="h-full w-full object-cover object-top"
          />
        </div>
        <div>
        <h3 class="font-semibold text-tierra-forest-dark">
          Ranjan Khan — Managing Director, Investment Committee
        </h3>
        <p class="mt-2 text-base leading-relaxed text-tierra-graphite/90">
          Penn Computer Science graduate with two decades delivering
          cross-functional programs in highly regulated environments. Former
          Director at Dun &amp; Bradstreet's Office of the CTO; led Volcker Rule
          reporting, global supervisory controls, and large-scale client
          onboarding at Credit Suisse and Morgan Stanley. Additional experience
          at Goldman Sachs, eGain, and IBM spanning operations, technology, and
          client outcomes. Leads business strategy, capital investments, and
          portfolio growth—bridging finance, operations, and technology for
          integrated execution.
        </p>
        </div>
      </section>

      <section class="flex flex-col items-start gap-6 sm:flex-row">
        <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-full border-2 border-tierra-stone/40">
          <Image
            src={josePhoto}
            alt="Jose Luis Zardoya"
            width={96}
            height={96}
            class="h-full w-full object-cover object-top"
          />
        </div>
        <div>
        <h3 class="font-semibold text-tierra-forest-dark">
          Jose Luis Zardoya — Managing Director, Investment Committee
        </h3>
        <p class="mt-2 text-base leading-relaxed text-tierra-graphite/90">
          Based in San Juan, Puerto Rico. Columbia Business School MBA and
          University of Pennsylvania graduate with more than two decades in
          capital markets and asset management. Currently Managing Director at
          Aragon Asset Management; previously held senior roles at
          Oppenheimer &amp; Co., CIBC World Markets, Cowen &amp; Company, and
          Caspian Securities. Proven track record running principal investments
          and client franchises across multiple market cycles—bringing deep
          institutional expertise and capital-raising relationships to the
          platform.
        </p>
        </div>
      </section>

      <section class="flex flex-col items-start gap-6 sm:flex-row">
        <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-full border-2 border-tierra-stone/40">
          <Image
            src={henryPhoto}
            alt="Henry González"
            width={96}
            height={96}
            class="h-full w-full object-cover object-top"
          />
        </div>
        <div>
        <h3 class="font-semibold text-tierra-forest-dark">
          Henry González — Local Market Execution
        </h3>
        <p class="mt-2 text-base leading-relaxed text-tierra-graphite/90">
          More than 13 years in Dominican real estate, including work with
          Espejo y Asociados, and founder of HG International. Focuses on
          local market execution in the Dominican Republic.
        </p>
        </div>
      </section>
    </div>

    <p class="mt-10">
      <Link
        href="/"
        class="font-medium text-tierra-forest underline decoration-tierra-stone underline-offset-4 hover:decoration-tierra-forest focus:outline-none focus:ring-2 focus:ring-tierra-lime focus:ring-offset-2"
      >
        Back to home
      </Link>
    </p>
  </article>
</BaseLayout>
